{
  "name": "gvie",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "gvie",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/telemetry"
      ],
      "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
      }
    },
    "apps/api": {
      "name": "@gvie/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@gvie/web",
      "version": "0.1.0"
    },
    "node_modules/@gvie/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@gvie/cloudinary": {
      "resolved": "packages/cloudinary",
      "link": true
    },
    "node_modules/@gvie/schemas": {
      "resolved": "packages/schemas",
      "link": true
    },
    "node_modules/@gvie/telemetry": {
      "resolved": "services/telemetry",
      "link": true
    },
    "node_modules/@gvie/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/cloudinary": {
      "name": "@gvie/cloudinary",
      "version": "0.1.0"
    },
    "packages/schemas": {
      "name": "@gvie/schemas",
      "version": "0.1.0"
    },
    "services/telemetry": {
      "name": "@gvie/telemetry",
      "version": "0.1.0"
    }
  }
}
